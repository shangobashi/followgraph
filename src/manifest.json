{
  "manifest_version": 3,
  "name": "FollowGraph",
  "version": "1.3.7",
  "version_name": "v1.3.7",
  "description": "FollowGraph v1.3.7. Client-side Following Exporter for X/Twitter with saved-checkpoint enrichment, cursor-aware scan completion, and captured API enrichment.",
  "author": "Shango Bashi",
  "permissions": ["scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["https://twitter.com/*", "https://x.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageCapture.js"],
      "matches": ["https://twitter.com/*", "https://x.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
