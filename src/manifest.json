{
  "manifest_version": 3,
  "name": "FollowGraph",
  "version": "1.4.2",
  "version_name": "v1.4.2 beta",
  "description": "FollowGraph v1.4.2 beta. Hardened API and helper-tab enrichment for 90% activity resolution.",
  "author": "Shango Bashi",
  "permissions": ["scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["https://twitter.com/*", "https://x.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageCapture.js"],
      "matches": ["https://twitter.com/*", "https://x.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
