{
  "name": "followgraph",
  "private": true,
  "version": "1.3.1",
  "description": "FollowGraph v1.3.1: client-side Following Exporter for X/Twitter with captured API enrichment and helper-tab fallback",
  "author": "Shango Bashi",
  "type": "module",
  "scripts": {
    "acceptance": "node scripts/acceptance-gate.mjs reports/latest.json",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:report": "node scripts/benchmark.mjs --total 7500 --concurrency 64 --latency-ms 350 --resolution-rate 0.9 --max-minutes 90 --min-resolution-rate 0.9 --report reports/latest.json",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
